#!/bin/sh
# Hook de git del proyecto GB Noodles · Microsites — instalado por la skill init-proyecto.
# Activo tras `git config core.hooksPath .githooks` (lo hace la skill en el Paso 4).
# Ejecuta las verificaciones mecánicas del repo y rechaza el commit si alguna falla.
# Si falla, se corrige el valor crudo, el archivo mal colocado o el índice; nunca el hook
# ni los scripts. Saltarlo con `--no-verify` exige anotar el motivo en el mensaje de commit.
#
# Las verificaciones de los módulos activos se ejecutan TODAS, aunque una falle: el commit se
# rechaza al final con el recuento. Son siete (más las propias del proyecto, si las hay): token-audit, ds-fidelity, proposals-index y ds-library (design-system),
# context-audit (siempre), y los índices de research y de analítica (investigacion). Así se ve todo lo que hay que arreglar en una sola pasada, en vez
# de descubrirlo de uno en uno (cada script audita una materia distinta y son independientes).
set -u
cd "$(git rev-parse --show-toplevel)"
PY="${PYTHON:-python3}"

# Solo hay control cuando el proyecto está conectado a un repositorio remoto. Un diseñador
# puede trabajar en local y conectarlo después: mientras no haya remoto, el commit pasa sin
# comprobar nada. En cuanto se añade (`git remote add …`), las comprobaciones se activan solas
# en el siguiente commit. A mano se pueden ejecutar siempre (ver AGENTS.md).
if [ -z "$(git remote)" ]; then
  echo "pre-commit · sin repositorio remoto: comprobaciones desactivadas hasta conectar uno"
  exit 0
fi
failed=""

# Solo se audita lo que este proyecto tiene. Un encargo de investigación y estrategia no
# arrastra la auditoría del design system: ver governance/modules.json.
if "$PY" scripts/ds-module.py --is-active design-system >/dev/null 2>&1; then
  echo "pre-commit · auditoría de valores crudos, estructura y showcase (DS)"
  "$PY" scripts/token-audit.py || failed="$failed token-audit"
  echo "pre-commit · fidelidad de los contratos a su maestro de Figma (DS)"
  "$PY" scripts/ds-fidelity.py || failed="$failed ds-fidelity"
  echo "pre-commit · propuestas en la carpeta de su estado e índice al día (DS)"
  "$PY" scripts/proposals-index.py --check || failed="$failed proposals-index"
  echo "pre-commit · presupuesto de lectura (DS, solo avisa)"
  "$PY" scripts/ds-budget.py || true
  echo "pre-commit · cambios de lo ya publicado con su propuesta aprobada (DS)"
  "$PY" scripts/ds-release.py --check || failed="$failed ds-release"
  echo "pre-commit · catálogo navegable (library/) al día con el design system (DS)"
  "$PY" scripts/ds-library.py --check || failed="$failed ds-library"
fi

echo "pre-commit · secciones obligatorias de context/"
"$PY" scripts/context-audit.py || failed="$failed context-audit"

if "$PY" scripts/ds-module.py --is-active investigacion >/dev/null 2>&1; then
  echo "pre-commit · índice de research"
  "$PY" scripts/research-index.py --check || failed="$failed research-index"
fi

if "$PY" scripts/ds-module.py --is-active investigacion >/dev/null 2>&1; then
  echo "pre-commit · índice de analítica"
  "$PY" scripts/research-index.py --dir analytics --check || failed="$failed analytics-index"
fi

# Comprobaciones propias del proyecto: una orden por línea en scripts/project-checks.txt (líneas vacías
# y «#» se ignoran). Ese archivo es del proyecto, no de la plantilla: una actualización de la skill
# sustituye este hook pero nunca lo toca, así lo que el proyecto añada sigue vigilándose.
if [ -f scripts/project-checks.txt ]; then
  while IFS= read -r check || [ -n "$check" ]; do
    case "$check" in ''|\#*) continue ;; esac
    echo "pre-commit · proyecto: $check"
    sh -c "$check" || failed="$failed $(printf '%s' "$check" | cut -c1-40)"
  done < scripts/project-checks.txt
fi

if [ -n "$failed" ]; then
  echo ""
  echo "pre-commit · commit rechazado — falla:$failed"
  exit 1
fi

echo "pre-commit · todo en verde"

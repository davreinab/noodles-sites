    "example": "<section data-ds=\"natural-improvement\" class=\"section natural-improvement\" aria-labelledby=\"ni-title\"><div class=\"section__inner\"><div class=\"natural-improvement__head\"><h2 class=\"natural-improvement__title\" id=\"ni-title\">That's what we call an improvement</h2><p class=\"natural-improvement__subtitle\">Every ingredient we removed has a natural replacement with a clear reason behind it.</p></div><div class=\"natural-improvement__block\"><h3 class=\"natural-improvement__heading\" id=\"ni-swaps\">Replaced ingredients</h3><ul class=\"natural-improvement__swaps\" aria-labelledby=\"ni-swaps\"><li class=\"ingredient-swap\"><span class=\"removed-tag\"><span class=\"icon icon-close\" aria-hidden=\"true\"></span><span class=\"visually-hidden\">Removed:</span><s class=\"removed-tag__text\">Palm oil</s></span><span class=\"icon icon-chevron-down ingredient-swap__arrow\" aria-hidden=\"true\"></span><div class=\"ingredient-swap__card\"><div class=\"ingredient-swap__text\"><p class=\"ingredient-swap__name\">Sunflower oil</p><p class=\"ingredient-swap__reason\">Cold-pressed, no tropical deforestation footprint.</p></div><img class=\"ingredient-swap__thumb\" src=\"../assets/images/placeholder.svg\" alt=\"\"></div></li></ul></div><div class=\"natural-improvement__block\"><h3 class=\"natural-improvement__heading\" id=\"ni-removed\">We also removed</h3><ul class=\"natural-improvement__removed\" aria-labelledby=\"ni-removed\"><li><span class=\"removed-tag\"><span class=\"icon icon-close\" aria-hidden=\"true\"></span><span class=\"visually-hidden\">Removed:</span><s class=\"removed-tag__text\">Preservatives</s></span></li></ul></div><div class=\"natural-improvement__block\"><h3 class=\"natural-improvement__heading\" id=\"ni-origins\">Ingredient origins</h3><p class=\"natural-improvement__origins-text\">The new formula improves the nutritional profile across the board, without adding a single minute to prep time.</p><div data-ds=\"origins-map\" class=\"origins-map\"><p class=\"origins-map__seal\">100% natural</p><ul class=\"origins-map__list\" aria-label=\"Ingredient origins\"><li class=\"origins-map__item\"><span class=\"origins-map__name\">Wheat</span><span class=\"visually-hidden\"> from </span><span class=\"origins-map__country\">Spain</span></li></ul></div></div></div></section>",

{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>type</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><p class="" data-ds="link">Consulta las <a class="link" href="/bases">bases legales</a> del concurso.</p></div><figcaption>type=Inline</figcaption></figure>
<figure><div class="ds-gallery__stage"><p class="link--standalone" data-ds="link">Consulta las <a class="link" href="/bases">bases legales</a> del concurso.</p></div><figcaption>type=Standalone</figcaption></figure>
</div></section>
<section><h3>surface</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><p class="" data-ds="link">Consulta las <a class="link" href="/bases">bases legales</a> del concurso.</p></div><figcaption>surface=Light</figcaption></figure>
<figure><div class="ds-gallery__stage"><p class="link--dark" data-ds="link">Consulta las <a class="link" href="/bases">bases legales</a> del concurso.</p></div><figcaption>surface=Dark</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">La galería clona el elemento raíz del ejemplo y solo cambia sus clases: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<p data-ds="link">Consulta las <a class="link" href="/bases">bases legales</a> del concurso.</p>
<a data-ds="link" class="link link--standalone" href="/recetas">Ver todas las recetas <span class="icon icon-arrow-right" aria-hidden="true"></span></a>
<a data-ds="link" class="link link--dark" href="/contacto" target="_blank" rel="noopener">Contacto <span class="icon icon-external-link" aria-hidden="true"></span><span class="visually-hidden"> (abre en una pestaña nueva)</span></a>{% endraw %}
{% endif %}
{% endmacro %}

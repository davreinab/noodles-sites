{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>status</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><article data-ds="contest-card" class="contest-card">
<div class="contest-card__media"><img src="/assets/ds/images/placeholder.svg" alt=""></div>
<div class="contest-card__body">
<p class="contest-card__dates" id="cc-slurp-dates">Available until 20/9/2026</p>
<h3 class="contest-card__title"><a class="contest-card__link" href="/contests/slurp-and-win" aria-describedby="cc-slurp-dates">Slurp &amp; Win</a></h3>
<ul class="contest-card__prizes" aria-label="Prizes">
<li><span class="chip">T-shirts</span></li>
<li><span class="chip">Balls</span></li>
<li><span class="chip">Experience</span></li>
</ul>
</div>
</article></div><figcaption>status=Closed</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">La galería clona el elemento raíz del ejemplo y solo cambia sus clases: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<article data-ds="contest-card" class="contest-card">
<div class="contest-card__media"><img src="/assets/ds/images/placeholder.svg" alt=""></div>
<div class="contest-card__body">
<p class="contest-card__dates" id="cc-slurp-dates">Available until 20/9/2026</p>
<h3 class="contest-card__title"><a class="contest-card__link" href="/contests/slurp-and-win" aria-describedby="cc-slurp-dates">Slurp &amp; Win</a></h3>
<ul class="contest-card__prizes" aria-label="Prizes">
<li><span class="chip">T-shirts</span></li>
<li><span class="chip">Balls</span></li>
<li><span class="chip">Experience</span></li>
</ul>
</div>
</article>
<article data-ds="contest-card" class="contest-card">
<div class="contest-card__media"><span class="badge badge--neutral">Closed</span><img src="/assets/ds/images/placeholder.svg" alt=""></div>
<div class="contest-card__body">
<p class="contest-card__dates" id="cc-old-dates">Ended on 20/9/2026</p>
<h3 class="contest-card__title"><a class="contest-card__link" href="/contests/old-contest" aria-describedby="cc-old-dates">Old contest</a></h3>
<ul class="contest-card__prizes" aria-label="Prizes">
<li><span class="chip">Balls</span></li>
</ul>
</div>
</article>{% endraw %}
{% endif %}
{% endmacro %}

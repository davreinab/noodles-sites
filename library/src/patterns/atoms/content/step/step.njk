{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>title (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><ol data-ds="step" class="steps">
<li class="step">
<span class="step__number" aria-hidden="true">1</span>
<div class="step__content"><h3 class="step__title">Add boiling water up to the mark</h3><p class="step__text">Open the lid halfway and pour the water in up to the inner line.</p></div>
</li>
<li class="step step--media">
<span class="step__number" aria-hidden="true">2</span>
<div class="step__content">
<p class="step__text">Leave to stand for 3 minutes.</p>
<div class="step__media"><img src="/assets/ds/images/placeholder.svg" alt="Cup filled up to the inner line with boiling water"></div>
</div>
</li>
</ol></div><figcaption>title=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><ol data-ds="step" class="steps">
<li class="step">
<span class="step__number" aria-hidden="true">1</span>
<div class="step__content"><p class="step__text">Open the lid halfway and pour the water in up to the inner line.</p></div>
</li>
<li class="step step--media">
<span class="step__number" aria-hidden="true">2</span>
<div class="step__content">
<p class="step__text">Leave to stand for 3 minutes.</p>
<div class="step__media"><img src="/assets/ds/images/placeholder.svg" alt="Cup filled up to the inner line with boiling water"></div>
</div>
</li>
</ol></div><figcaption>title=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">No se han podido pintar: media=true (no hay clase ni atributo declarados para ella: declara su selector en modifiers). La galería clona el elemento raíz del ejemplo, con los contenedores que le dan color o fondo, y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<ol data-ds="step" class="steps">
<li class="step">
<span class="step__number" aria-hidden="true">1</span>
<div class="step__content"><h3 class="step__title">Add boiling water up to the mark</h3><p class="step__text">Open the lid halfway and pour the water in up to the inner line.</p></div>
</li>
<li class="step step--media">
<span class="step__number" aria-hidden="true">2</span>
<div class="step__content">
<p class="step__text">Leave to stand for 3 minutes.</p>
<div class="step__media"><img src="/assets/ds/images/placeholder.svg" alt="Cup filled up to the inner line with boiling water"></div>
</div>
</li>
</ol>{% endraw %}
{% endif %}
{% endmacro %}

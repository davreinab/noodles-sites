{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>running (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><section data-ds="timer" class="timer" data-state="running" aria-labelledby="timer-title">
<h3 class="visually-hidden" id="timer-title">Temporizador de preparación</h3>
<div class="timer__dial">
<svg class="timer__ring" viewBox="0 0 100 100" aria-hidden="true"><circle class="timer__track" cx="50" cy="50" r="46" stroke-width="8" pathLength="100"/><circle class="timer__progress" cx="50" cy="50" r="46" stroke-width="8" pathLength="100" stroke-dashoffset="40"/></svg>
<div class="timer__readout"><span class="timer__time" role="timer">1:48</span><span class="timer__label">Quedan</span></div>
</div>
<p class="visually-hidden" aria-live="polite"></p>
<div class="timer__controls">
<button class="button button--secondary" type="button"><span class="icon icon-pause" aria-hidden="true"></span>Pausar</button>
<button class="icon-button icon-button--secondary" type="button" aria-label="Reiniciar"><span class="icon icon-rotate-ccw" aria-hidden="true"></span></button>
</div>
</section></div><figcaption>running=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><section data-ds="timer" class="timer" aria-labelledby="timer-title-v1">
<h3 class="visually-hidden" id="timer-title-v1">Temporizador de preparación</h3>
<div class="timer__dial">
<svg class="timer__ring" viewBox="0 0 100 100" aria-hidden="true"><circle class="timer__track" cx="50" cy="50" r="46" stroke-width="8" pathLength="100"/><circle class="timer__progress" cx="50" cy="50" r="46" stroke-width="8" pathLength="100" stroke-dashoffset="40"/></svg>
<div class="timer__readout"><span class="timer__time" role="timer">1:48</span><span class="timer__label">Quedan</span></div>
</div>

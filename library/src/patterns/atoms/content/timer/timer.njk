{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>layout</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><section data-ds="timer" class="timer" data-state="running" aria-labelledby="timer-title">
<h3 class="timer__title" id="timer-title">Not a second more!</h3>
<p class="timer__subtitle">Use our timer to prepare your Yatekomo.</p>
<span class="timer__time" role="timer">1:48</span>
<p class="timer__label">Remaining</p>
<progress class="timer__bar" max="100" value="60" aria-label="Time remaining"></progress>
<div class="timer__controls">
<button class="button button--secondary" type="button"><span class="icon icon-pause" aria-hidden="true"></span>Pause</button>
<button class="timer__reset" type="button"><span>Reset</span><span class="icon icon-arrow-right" aria-hidden="true"></span></button>
<button class="icon-button icon-button--secondary timer__reset-icon" type="button" aria-label="Reset"><span class="icon icon-rotate-ccw" aria-hidden="true"></span></button>
</div>
<p class="visually-hidden" aria-live="polite"></p>
</section></div><figcaption>layout=Default</figcaption></figure>
<figure><div class="ds-gallery__stage"><section data-ds="timer" class="timer timer--compact" data-state="running" aria-labelledby="timer-title-v1">

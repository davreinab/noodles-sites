<button class="icon-button icon-button--secondary" type="button" aria-label="Reiniciar"><span class="icon icon-rotate-ccw" aria-hidden="true"></span></button>
</div>
</section></div><figcaption>paused=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><section data-ds="timer" class="timer" aria-labelledby="timer-title-v3">
<h3 class="visually-hidden" id="timer-title-v3">Temporizador de preparación</h3>

{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>ratio</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="video-player" class="video-player">
<img class="video-player__poster" src="/assets/ds/images/placeholder.svg" alt="">
<button class="video-player__play" type="button" aria-label="Reproducir vídeo: Gana un viaje a Tokio (0:45)"><span class="icon icon-play" aria-hidden="true"></span></button>
<span class="video-player__duration" aria-hidden="true">0:45</span>
</div></div><figcaption>ratio=16:9</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="video-player" class="video-player video-player--vertical">
<img class="video-player__poster" src="/assets/ds/images/placeholder.svg" alt="">
<button class="video-player__play" type="button" aria-label="Reproducir vídeo: Gana un viaje a Tokio (0:45)"><span class="icon icon-play" aria-hidden="true"></span></button>
<span class="video-player__duration" aria-hidden="true">0:45</span>
</div></div><figcaption>ratio=9:16</figcaption></figure>
</div></section>
<section><h3>poster (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="video-player" class="video-player">
<img class="video-player__poster" src="/assets/ds/images/placeholder.svg" alt="">
<button class="video-player__play" type="button" aria-label="Reproducir vídeo: Gana un viaje a Tokio (0:45)"><span class="icon icon-play" aria-hidden="true"></span></button>
<span class="video-player__duration" aria-hidden="true">0:45</span>
</div></div><figcaption>poster=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="video-player" class="video-player">

<button class="video-player__play" type="button" aria-label="Reproducir vídeo: Gana un viaje a Tokio (0:45)"><span class="icon icon-play" aria-hidden="true"></span></button>
<span class="video-player__duration" aria-hidden="true">0:45</span>
</div></div><figcaption>poster=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">No se han podido pintar (sin clase conocida en el contrato ni en el CSS): playing=true (el elemento «iframe» no sale en el ejemplo). La galería clona el elemento raíz del ejemplo y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<div data-ds="video-player" class="video-player">
<img class="video-player__poster" src="/assets/ds/images/placeholder.svg" alt="">
<button class="video-player__play" type="button" aria-label="Reproducir vídeo: Gana un viaje a Tokio (0:45)"><span class="icon icon-play" aria-hidden="true"></span></button>
<span class="video-player__duration" aria-hidden="true">0:45</span>
</div>
<div data-ds="video-player" class="video-player video-player--vertical"><span class="video-player__title">Receta en vídeo</span></div>
<div data-ds="video-player" class="video-player"><iframe title="Vídeo: Gana un viaje a Tokio" src="/assets/ds/images/placeholder.svg"></iframe></div>{% endraw %}
{% endif %}
{% endmacro %}

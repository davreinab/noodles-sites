{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>type</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="alert" class="alert" role="status">
<span class="icon icon-info" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Información</p><p class="alert__body">El concurso abre el 1 de noviembre.</p></div>
<button class="alert__close" type="button" aria-label="Cerrar aviso"><span class="icon icon-close" aria-hidden="true"></span></button>
</div></div><figcaption>type=Info</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="alert" class="alert alert--success" role="status">
<span class="icon icon-info" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Información</p><p class="alert__body">El concurso abre el 1 de noviembre.</p></div>
<button class="alert__close" type="button" aria-label="Cerrar aviso"><span class="icon icon-close" aria-hidden="true"></span></button>
</div></div><figcaption>type=Success</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="alert" class="alert alert--alert" role="status">
<span class="icon icon-info" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Información</p><p class="alert__body">El concurso abre el 1 de noviembre.</p></div>
<button class="alert__close" type="button" aria-label="Cerrar aviso"><span class="icon icon-close" aria-hidden="true"></span></button>
</div></div><figcaption>type=Alert</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="alert" class="alert alert--error" role="status">
<span class="icon icon-info" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Información</p><p class="alert__body">El concurso abre el 1 de noviembre.</p></div>
<button class="alert__close" type="button" aria-label="Cerrar aviso"><span class="icon icon-close" aria-hidden="true"></span></button>
</div></div><figcaption>type=Error</figcaption></figure>
</div></section>
<section><h3>layout</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="alert" class="alert" role="status">
<span class="icon icon-info" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Información</p><p class="alert__body">El concurso abre el 1 de noviembre.</p></div>
<button class="alert__close" type="button" aria-label="Cerrar aviso"><span class="icon icon-close" aria-hidden="true"></span></button>
</div></div><figcaption>layout=Inline</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="alert" class="alert alert--toast" role="status">
<span class="icon icon-info" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Información</p><p class="alert__body">El concurso abre el 1 de noviembre.</p></div>
<button class="alert__close" type="button" aria-label="Cerrar aviso"><span class="icon icon-close" aria-hidden="true"></span></button>
</div></div><figcaption>layout=Toast</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">No se han podido pintar (sin clase conocida en el contrato ni en el CSS): dismissible=true. La galería clona el elemento raíz del ejemplo y solo cambia sus clases: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<div data-ds="alert" class="alert" role="status">
<span class="icon icon-info" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Información</p><p class="alert__body">El concurso abre el 1 de noviembre.</p></div>
<button class="alert__close" type="button" aria-label="Cerrar aviso"><span class="icon icon-close" aria-hidden="true"></span></button>
</div>
<div data-ds="alert" class="alert alert--error alert--toast" role="alert">
<span class="icon icon-circle-alert" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Algo ha fallado</p><p class="alert__body">No hemos podido cargar el contenido.</p></div>
</div>
<div data-ds="alert" class="alert alert--success" role="status">
<span class="icon icon-circle-check" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Participación enviada</p><p class="alert__body">Te avisaremos por correo si ganas.</p></div>
</div>
<div data-ds="alert" class="alert alert--alert" role="status">
<span class="icon icon-triangle-alert" aria-hidden="true"></span>
<div class="alert__content"><p class="alert__title">Quedan pocas horas</p><p class="alert__body">El concurso cierra hoy a las 23:59.</p></div>
</div>{% endraw %}
{% endif %}
{% endmacro %}

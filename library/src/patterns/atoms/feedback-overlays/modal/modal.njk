{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>size</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><dialog data-ds="modal" class="modal" aria-labelledby="modal-title" open>
<div class="modal__header">
<h2 class="modal__title" id="modal-title">Etiqueta del envase</h2>
<button class="icon-button icon-button--secondary" type="button" aria-label="Cerrar"><span class="icon icon-close" aria-hidden="true"></span></button>
</div>
<div class="modal__body"><div class="modal-slot">Contenido</div></div>
<div class="modal__footer"><button class="button" type="button">Entendido</button></div>
</dialog></div><figcaption>size=M</figcaption></figure>
<figure><div class="ds-gallery__stage"><dialog data-ds="modal" class="modal" aria-labelledby="modal-title-v1" open>
<div class="modal__header">
<h2 class="modal__title" id="modal-title-v1">Etiqueta del envase</h2>
<button class="icon-button icon-button--secondary" type="button" aria-label="Cerrar"><span class="icon icon-close" aria-hidden="true"></span></button>
</div>
<div class="modal__body"><div class="modal-slot">Contenido</div></div>
<div class="modal__footer"><button class="button" type="button">Entendido</button></div>
</dialog></div><figcaption>size=L</figcaption></figure>
<figure><div class="ds-gallery__stage"><dialog data-ds="modal" class="modal modal--full" aria-labelledby="modal-title-v2" open>
<div class="modal__header">
<h2 class="modal__title" id="modal-title-v2">Etiqueta del envase</h2>
<button class="icon-button icon-button--secondary" type="button" aria-label="Cerrar"><span class="icon icon-close" aria-hidden="true"></span></button>
</div>
<div class="modal__body"><div class="modal-slot">Contenido</div></div>
<div class="modal__footer"><button class="button" type="button">Entendido</button></div>
</dialog></div><figcaption>size=Full</figcaption></figure>
</div></section>
<section><h3>footer (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><dialog data-ds="modal" class="modal modal--l" aria-labelledby="modal-title-v3" open>
<div class="modal__header">
<h2 class="modal__title" id="modal-title-v3">Etiqueta del envase</h2>
<button class="icon-button icon-button--secondary" type="button" aria-label="Cerrar"><span class="icon icon-close" aria-hidden="true"></span></button>
</div>
<div class="modal__body"><div class="modal-slot">Contenido</div></div>
<div class="modal__footer"><button class="button" type="button">Entendido</button></div>
</dialog></div><figcaption>footer=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><dialog data-ds="modal" class="modal modal--l" aria-labelledby="modal-title-v4" open>
<div class="modal__header">
<h2 class="modal__title" id="modal-title-v4">Etiqueta del envase</h2>
<button class="icon-button icon-button--secondary" type="button" aria-label="Cerrar"><span class="icon icon-close" aria-hidden="true"></span></button>
</div>
<div class="modal__body"><div class="modal-slot">Contenido</div></div>

</dialog></div><figcaption>footer=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">La galería clona el elemento raíz del ejemplo y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<dialog data-ds="modal" class="modal modal--l" aria-labelledby="modal-title" open>
<div class="modal__header">
<h2 class="modal__title" id="modal-title">Etiqueta del envase</h2>
<button class="icon-button icon-button--secondary" type="button" aria-label="Cerrar"><span class="icon icon-close" aria-hidden="true"></span></button>
</div>
<div class="modal__body"><div class="modal-slot">Contenido</div></div>
<div class="modal__footer"><button class="button" type="button">Entendido</button></div>
</dialog>
<dialog data-ds="modal" class="modal modal--full" aria-labelledby="modal-full-title" open>
<div class="modal__header">
<h2 class="modal__title" id="modal-full-title">Alérgenos</h2>
<button class="icon-button icon-button--secondary" type="button" aria-label="Cerrar"><span class="icon icon-close" aria-hidden="true"></span></button>
</div>
<div class="modal__body"><div class="modal-slot">Contenido</div></div>
</dialog>{% endraw %}
{% endif %}
{% endmacro %}

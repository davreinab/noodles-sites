{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>error (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><label data-ds="checkbox" class="checkbox">
<input class="checkbox__input" type="checkbox" name="bases" required aria-invalid="true">
<span class="checkbox__label">Acepto las <a class="link" href="/bases">bases legales</a></span>
</label></div><figcaption>error=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><label data-ds="checkbox" class="checkbox">
<input class="checkbox__input" type="checkbox" name="bases" required>
<span class="checkbox__label">Acepto las <a class="link" href="/bases">bases legales</a></span>
</label></div><figcaption>error=false</figcaption></figure>
</div></section>
<section><h3>disabled (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><label data-ds="checkbox" class="checkbox">
<input class="checkbox__input" type="checkbox" name="bases" required disabled>
<span class="checkbox__label">Acepto las <a class="link" href="/bases">bases legales</a></span>
</label></div><figcaption>disabled=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><label data-ds="checkbox" class="checkbox">
<input class="checkbox__input" type="checkbox" name="bases" required>
<span class="checkbox__label">Acepto las <a class="link" href="/bases">bases legales</a></span>
</label></div><figcaption>disabled=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">La galería clona el elemento raíz del ejemplo, con los contenedores que le dan color o fondo, y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<label data-ds="checkbox" class="checkbox">
<input class="checkbox__input" type="checkbox" name="bases" required>
<span class="checkbox__label">Acepto las <a class="link" href="/bases">bases legales</a></span>
</label>
<label data-ds="checkbox" class="checkbox">
<input class="checkbox__input" type="checkbox" name="privacidad" required aria-invalid="true">
<span class="checkbox__label">Acepto la <a class="link" href="/privacidad">política de privacidad</a></span>
</label>
<label data-ds="checkbox" class="checkbox">
<input class="checkbox__input" type="checkbox" name="novedades" disabled>
<span class="checkbox__label">Quiero recibir novedades por correo</span>
</label>{% endraw %}
{% endif %}
{% endmacro %}

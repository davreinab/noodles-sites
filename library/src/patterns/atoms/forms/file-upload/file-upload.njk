{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>empty (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="file-upload" class="field file-upload">
<label class="field__label" id="fu-front-label" for="fu-front">Upload receipt – front<span class="field__required" aria-hidden="true">*</span></label>
<div class="file-upload__control">
<label class="button button--secondary file-upload__trigger">
<input class="visually-hidden file-upload__input" id="fu-front" name="receipt-front" type="file" accept="image/jpeg,image/png,application/pdf" required aria-labelledby="fu-front-label" aria-describedby="fu-front-help fu-front-status">
<span>Upload file</span>
</label>
<p class="file-upload__status" id="fu-front-status" aria-live="polite">No file selected — JPG, PNG or PDF, max 5MB</p>
</div>
<p class="field__helper" id="fu-front-help">Make sure the purchased products are clearly visible on the receipt.</p>
</div></div><figcaption>empty=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="file-upload" class="field file-upload">
<label class="field__label" id="fu-front-label-v1" for="fu-front-v1">Upload receipt – front<span class="field__required" aria-hidden="true">*</span></label>
<div class="file-upload__control">
<label class="button button--secondary file-upload__trigger">
<input class="visually-hidden file-upload__input" id="fu-front-v1" name="receipt-front" type="file" accept="image/jpeg,image/png,application/pdf" required aria-labelledby="fu-front-label-v1" aria-describedby="fu-front-help-v1 fu-front-status">
<span>Upload file</span>
</label>

</div>
<p class="field__helper" id="fu-front-help-v1">Make sure the purchased products are clearly visible on the receipt.</p>
</div></div><figcaption>empty=false</figcaption></figure>
</div></section>
<section><h3>error (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="file-upload" class="field file-upload">
<label class="field__label" id="fu-front-label-v2" for="fu-front-v2">Upload receipt – front<span class="field__required" aria-hidden="true">*</span></label>
<div class="file-upload__control">
<label class="button button--secondary file-upload__trigger">
<input class="visually-hidden file-upload__input" id="fu-front-v2" name="receipt-front" type="file" accept="image/jpeg,image/png,application/pdf" required aria-labelledby="fu-front-label-v2" aria-describedby="fu-front-help-v2 fu-front-status-v2" aria-invalid="true">
<span>Upload file</span>
</label>
<p class="file-upload__status" id="fu-front-status-v2" aria-live="polite">No file selected — JPG, PNG or PDF, max 5MB</p>
</div>
<p class="field__helper" id="fu-front-help-v2">Make sure the purchased products are clearly visible on the receipt.</p>
</div></div><figcaption>error=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="file-upload" class="field file-upload">
<label class="field__label" id="fu-front-label-v3" for="fu-front-v3">Upload receipt – front<span class="field__required" aria-hidden="true">*</span></label>
<div class="file-upload__control">
<label class="button button--secondary file-upload__trigger">
<input class="visually-hidden file-upload__input" id="fu-front-v3" name="receipt-front" type="file" accept="image/jpeg,image/png,application/pdf" required aria-labelledby="fu-front-label-v3" aria-describedby="fu-front-help-v3 fu-front-status-v3">
<span>Upload file</span>
</label>
<p class="file-upload__status" id="fu-front-status-v3" aria-live="polite">No file selected — JPG, PNG or PDF, max 5MB</p>
</div>
<p class="field__helper" id="fu-front-help-v3">Make sure the purchased products are clearly visible on the receipt.</p>
</div></div><figcaption>error=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">La galería clona el elemento raíz del ejemplo y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<div data-ds="file-upload" class="field file-upload">
<label class="field__label" id="fu-front-label" for="fu-front">Upload receipt – front<span class="field__required" aria-hidden="true">*</span></label>
<div class="file-upload__control">
<label class="button button--secondary file-upload__trigger">
<input class="visually-hidden file-upload__input" id="fu-front" name="receipt-front" type="file" accept="image/jpeg,image/png,application/pdf" required aria-labelledby="fu-front-label" aria-describedby="fu-front-help fu-front-status">
<span>Upload file</span>
</label>
<p class="file-upload__status" id="fu-front-status" aria-live="polite">No file selected — JPG, PNG or PDF, max 5MB</p>
</div>
<p class="field__helper" id="fu-front-help">Make sure the purchased products are clearly visible on the receipt.</p>
</div>
<div data-ds="file-upload" class="field file-upload">
<label class="field__label" id="fu-back-label" for="fu-back">Upload receipt – back<span class="field__required" aria-hidden="true">*</span></label>
<div class="file-upload__control">
<label class="button button--secondary file-upload__trigger">
<input class="visually-hidden file-upload__input" id="fu-back" name="receipt-back" type="file" accept="image/jpeg,image/png,application/pdf" aria-labelledby="fu-back-label" aria-describedby="fu-back-help fu-back-status">
<span>Upload file</span>
</label>
<p class="file-upload__status file-upload__status--selected" id="fu-back-status" aria-live="polite">receipt-back.jpg</p>
<button class="icon-button icon-button--secondary file-upload__remove" type="button" aria-label="Remove receipt-back.jpg"><span class="icon icon-close" aria-hidden="true"></span></button>
</div>
<p class="field__helper" id="fu-back-help">Optional: the back of the receipt.</p>
</div>
<div data-ds="file-upload" class="field file-upload">
<label class="field__label" id="fu-err-label" for="fu-err">Upload receipt – front<span class="field__required" aria-hidden="true">*</span></label>
<div class="file-upload__control">
<label class="button button--secondary file-upload__trigger">
<input class="visually-hidden file-upload__input" id="fu-err" name="receipt-err" type="file" aria-invalid="true" required aria-labelledby="fu-err-label" aria-describedby="fu-err-help fu-err-status fu-err-error">
<span>Upload file</span>
</label>
<p class="file-upload__status" id="fu-err-status" aria-live="polite">No file selected — JPG, PNG or PDF, max 5MB</p>
</div>
<p class="field__helper" id="fu-err-help">Make sure the purchased products are clearly visible on the receipt.</p>
<p class="field__error" id="fu-err-error">The file is bigger than 5MB. Choose another one.</p>
</div>{% endraw %}
{% endif %}
{% endmacro %}

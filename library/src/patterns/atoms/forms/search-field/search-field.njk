{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>filled (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><form data-ds="search-field" class="search-field" role="search" action="/buscar">
<span class="icon icon-search" aria-hidden="true"></span>
<label class="visually-hidden" for="q">Buscar recetas y productos</label>
<input class="search-field__input" id="q" name="q" type="search" placeholder="Buscar recetas y productos" value="fideos yakisoba">
<button class="search-field__clear" type="button" aria-label="Borrar búsqueda"><span class="icon icon-close" aria-hidden="true"></span></button>
</form></div><figcaption>filled=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><form data-ds="search-field" class="search-field" role="search" action="/buscar">
<span class="icon icon-search" aria-hidden="true"></span>
<label class="visually-hidden" for="q-v1">Buscar recetas y productos</label>
<input class="search-field__input" id="q-v1" name="q" type="search" placeholder="Buscar recetas y productos">
<button class="search-field__clear" type="button" aria-label="Borrar búsqueda"><span class="icon icon-close" aria-hidden="true"></span></button>
</form></div><figcaption>filled=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">La galería clona el elemento raíz del ejemplo y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<form data-ds="search-field" class="search-field" role="search" action="/buscar">
<span class="icon icon-search" aria-hidden="true"></span>
<label class="visually-hidden" for="q">Buscar recetas y productos</label>
<input class="search-field__input" id="q" name="q" type="search" placeholder="Buscar recetas y productos">
<button class="search-field__clear" type="button" aria-label="Borrar búsqueda"><span class="icon icon-close" aria-hidden="true"></span></button>
</form>
<form data-ds="search-field" class="search-field" role="search" action="/buscar">
<span class="icon icon-search" aria-hidden="true"></span>
<label class="visually-hidden" for="q-con-texto">Buscar recetas y productos</label>
<input class="search-field__input" id="q-con-texto" name="q" type="search" value="fideos yakisoba">
<button class="search-field__clear" type="button" aria-label="Borrar búsqueda"><span class="icon icon-close" aria-hidden="true"></span></button>
</form>{% endraw %}
{% endif %}
{% endmacro %}

{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>required (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="select" class="field">
<label class="field__label" for="pais">País<span class="field__required" aria-hidden="true">*</span></label>
<div class="field__select">
<select class="field__control" id="pais" name="pais" required aria-invalid="true" aria-describedby="pais-error">
<option value="">Elige una opción</option>
<option value="es">España</option>
<option value="fr">Francia</option>
</select>
</div>
<p class="field__error" id="pais-error"><span class="icon icon-circle-alert" aria-hidden="true"></span>Elige un país</p>
</div></div><figcaption>required=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="select" class="field">
<label class="field__label" for="pais-v1">País<span class="field__required" aria-hidden="true">*</span></label>
<div class="field__select">
<select class="field__control" id="pais-v1" name="pais" aria-invalid="true" aria-describedby="pais-error-v1">
<option value="">Elige una opción</option>
<option value="es">España</option>
<option value="fr">Francia</option>
</select>
</div>
<p class="field__error" id="pais-error-v1"><span class="icon icon-circle-alert" aria-hidden="true"></span>Elige un país</p>
</div></div><figcaption>required=false</figcaption></figure>
</div></section>
<section><h3>error (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="select" class="field">
<label class="field__label" for="pais-v2">País<span class="field__required" aria-hidden="true">*</span></label>
<div class="field__select">
<select class="field__control" id="pais-v2" name="pais" required aria-invalid="true" aria-describedby="pais-error-v2">
<option value="">Elige una opción</option>
<option value="es">España</option>
<option value="fr">Francia</option>
</select>
</div>
<p class="field__error" id="pais-error-v2"><span class="icon icon-circle-alert" aria-hidden="true"></span>Elige un país</p>
</div></div><figcaption>error=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="select" class="field">
<label class="field__label" for="pais-v3">País<span class="field__required" aria-hidden="true">*</span></label>
<div class="field__select">
<select class="field__control" id="pais-v3" name="pais" required aria-describedby="pais-error-v3">
<option value="">Elige una opción</option>

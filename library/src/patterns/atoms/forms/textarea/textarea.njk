{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>required (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="textarea" class="field">
<label class="field__label" for="mensaje">Mensaje<span class="field__required" aria-hidden="true">*</span></label>
<textarea class="field__control field__control--textarea" id="mensaje" name="mensaje" placeholder="Escribe aquí" required aria-describedby="mensaje-ayuda"></textarea>
<p class="field__helper" id="mensaje-ayuda">Máximo 500 caracteres</p>
</div></div><figcaption>required=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="textarea" class="field">
<label class="field__label" for="mensaje-v1">Mensaje<span class="field__required" aria-hidden="true">*</span></label>
<textarea class="field__control field__control--textarea" id="mensaje-v1" name="mensaje" placeholder="Escribe aquí" aria-describedby="mensaje-ayuda-v1"></textarea>
<p class="field__helper" id="mensaje-ayuda-v1">Máximo 500 caracteres</p>
</div></div><figcaption>required=false</figcaption></figure>
</div></section>
<section><h3>helper (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="textarea" class="field">
<label class="field__label" for="mensaje-v2">Mensaje<span class="field__required" aria-hidden="true">*</span></label>
<textarea class="field__control field__control--textarea" id="mensaje-v2" name="mensaje" placeholder="Escribe aquí" required aria-describedby="mensaje-ayuda-v2"></textarea>
<p class="field__helper" id="mensaje-ayuda-v2">Máximo 500 caracteres</p>
</div></div><figcaption>helper=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="textarea" class="field">
<label class="field__label" for="mensaje-v3">Mensaje<span class="field__required" aria-hidden="true">*</span></label>
<textarea class="field__control field__control--textarea" id="mensaje-v3" name="mensaje" placeholder="Escribe aquí" required aria-describedby="mensaje-ayuda"></textarea>

</div></div><figcaption>helper=false</figcaption></figure>
</div></section>
<section><h3>error (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="textarea" class="field">
<label class="field__label" for="mensaje-v4">Mensaje<span class="field__required" aria-hidden="true">*</span></label>
<textarea class="field__control field__control--textarea" id="mensaje-v4" name="mensaje" placeholder="Escribe aquí" required aria-describedby="mensaje-ayuda-v4" aria-invalid="true"></textarea>
<p class="field__helper" id="mensaje-ayuda-v4">Máximo 500 caracteres</p>
</div></div><figcaption>error=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="textarea" class="field">
<label class="field__label" for="mensaje-v5">Mensaje<span class="field__required" aria-hidden="true">*</span></label>
<textarea class="field__control field__control--textarea" id="mensaje-v5" name="mensaje" placeholder="Escribe aquí" required aria-describedby="mensaje-ayuda-v5"></textarea>
<p class="field__helper" id="mensaje-ayuda-v5">Máximo 500 caracteres</p>
</div></div><figcaption>error=false</figcaption></figure>
</div></section>
<section><h3>disabled (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><div data-ds="textarea" class="field">
<label class="field__label" for="mensaje-v6">Mensaje<span class="field__required" aria-hidden="true">*</span></label>
<textarea class="field__control field__control--textarea" id="mensaje-v6" name="mensaje" placeholder="Escribe aquí" required aria-describedby="mensaje-ayuda-v6" disabled></textarea>
<p class="field__helper" id="mensaje-ayuda-v6">Máximo 500 caracteres</p>
</div></div><figcaption>disabled=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><div data-ds="textarea" class="field">
<label class="field__label" for="mensaje-v7">Mensaje<span class="field__required" aria-hidden="true">*</span></label>
<textarea class="field__control field__control--textarea" id="mensaje-v7" name="mensaje" placeholder="Escribe aquí" required aria-describedby="mensaje-ayuda-v7"></textarea>
<p class="field__helper" id="mensaje-ayuda-v7">Máximo 500 caracteres</p>
</div></div><figcaption>disabled=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">No se pintan por su naturaleza (declarado en coverageIgnore): filled=true: El texto va dentro de la etiqueta, no en un atributo: se ve en el «Ejemplo de código».. La galería clona el elemento raíz del ejemplo y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<div data-ds="textarea" class="field">
<label class="field__label" for="mensaje">Mensaje<span class="field__required" aria-hidden="true">*</span></label>
<textarea class="field__control field__control--textarea" id="mensaje" name="mensaje" placeholder="Escribe aquí" required aria-describedby="mensaje-ayuda"></textarea>
<p class="field__helper" id="mensaje-ayuda">Máximo 500 caracteres</p>
</div>
<div data-ds="textarea" class="field">
<label class="field__label" for="respuesta">Respuesta</label>
<textarea class="field__control field__control--textarea" id="respuesta" aria-invalid="true" aria-describedby="respuesta-error"></textarea>
<p class="field__error" id="respuesta-error"><span class="icon icon-circle-alert" aria-hidden="true"></span>Este campo es obligatorio</p>
</div>
<div data-ds="textarea" class="field">
<label class="field__label" for="comentario">Comentario</label>
<textarea class="field__control field__control--textarea" id="comentario" name="comentario">Me encantan los fideos, pero me gustaría más opciones sin gluten.</textarea>
</div>
<div data-ds="textarea" class="field">
<label class="field__label" for="notas-cerradas">Notas del pedido</label>
<textarea class="field__control field__control--textarea" id="notas-cerradas" name="notas-cerradas" disabled>Pedido cerrado. No se pueden añadir notas.</textarea>
</div>{% endraw %}
{% endif %}
{% endmacro %}

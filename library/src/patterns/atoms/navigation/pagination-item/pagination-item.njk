{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>icon (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><ul data-ds="pagination-item" class="pagination__list">
<li><a class="pagination__link pagination__page" href="?page=2">2</a></li>
<li><a class="pagination__link pagination__page" href="?page=1" aria-current="page">1</a></li>
<li><button class="pagination__link" type="button" disabled aria-label="Previous page"><span class="pagination__text">Previous</span></button></li>
<li><a class="pagination__link" href="?page=2" aria-label="Next page"><span class="icon icon-arrow-right" aria-hidden="true"></span></a></li>
</ul></div><figcaption>icon=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><ul data-ds="pagination-item" class="pagination__list">
<li><a class="pagination__link pagination__page" href="?page=2">2</a></li>
<li><a class="pagination__link pagination__page" href="?page=1" aria-current="page">1</a></li>
<li><button class="pagination__link" type="button" disabled aria-label="Previous page"><span class="pagination__text">Previous</span></button></li>
<li><a class="pagination__link" href="?page=2" aria-label="Next page"></a></li>
</ul></div><figcaption>icon=false</figcaption></figure>
</div></section>
<section><h3>disabled (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><ul data-ds="pagination-item" class="pagination__list">
<li><a class="pagination__link pagination__page" href="?page=2">2</a></li>
<li><a class="pagination__link pagination__page" href="?page=1" aria-current="page">1</a></li>
<li><button class="pagination__link" type="button" disabled aria-label="Previous page"><span class="pagination__text">Previous</span></button></li>
<li><a class="pagination__link" href="?page=2" aria-label="Next page"><span class="icon icon-arrow-right" aria-hidden="true"></span></a></li>
</ul></div><figcaption>disabled=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><ul data-ds="pagination-item" class="pagination__list">
<li><a class="pagination__link pagination__page" href="?page=2">2</a></li>
<li><a class="pagination__link pagination__page" href="?page=1" aria-current="page">1</a></li>
<li><button class="pagination__link" type="button" aria-label="Previous page"><span class="pagination__text">Previous</span></button></li>
<li><a class="pagination__link" href="?page=2" aria-label="Next page"><span class="icon icon-arrow-right" aria-hidden="true"></span></a></li>
</ul></div><figcaption>disabled=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">No se han podido pintar: current=true (no hay clase ni atributo declarados para ella: declara su selector en modifiers). La galería clona el elemento raíz del ejemplo, con los contenedores que le dan color o fondo, y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<ul data-ds="pagination-item" class="pagination__list">
<li><a class="pagination__link pagination__page" href="?page=2">2</a></li>
<li><a class="pagination__link pagination__page" href="?page=1" aria-current="page">1</a></li>
<li><button class="pagination__link" type="button" disabled aria-label="Previous page"><span class="pagination__text">Previous</span></button></li>
<li><a class="pagination__link" href="?page=2" aria-label="Next page"><span class="icon icon-arrow-right" aria-hidden="true"></span></a></li>
</ul>{% endraw %}
{% endif %}
{% endmacro %}

{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>variant</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><section data-ds="contest-result" class="section contest-result" aria-labelledby="cr-title">
<div class="contest-result__inner">
<h1 class="contest-result__title" id="cr-title">Oh crap… Your entry hasn't won a prize this time</h1>
<p class="contest-result__text"><strong>Don't lose your one use 15% discount voucher</strong><br>Download it and use it in your next Yatekomo noodle cup purchase:</p>
<div data-ds="voucher" class="voucher">
<div class="voucher__main"><p class="voucher__value">15% OFF</p><p class="voucher__label">Discount voucher</p></div>
<div class="voucher__stub"><img class="voucher__barcode" src="/assets/ds/images/placeholder.svg" alt="Barcode 0876562-R"><span class="voucher__code" aria-hidden="true">0876562-R</span></div>
</div>
<a class="button button--l" href="/contests/slurp-and-win/voucher.pdf" download>Download discount voucher</a>
</div>
</section></div><figcaption>variant=Lose</figcaption></figure>
<figure><div class="ds-gallery__stage"><section data-ds="contest-result" class="section contest-result contest-result--win" aria-labelledby="cr-title-v1">
<div class="contest-result__inner">
<h1 class="contest-result__title" id="cr-title-v1">Oh crap… Your entry hasn't won a prize this time</h1>

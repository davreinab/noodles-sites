</div>
<a class="button button--l" href="/contests/slurp-and-win/voucher.pdf" download>Download discount voucher</a>
</div>
</section></div><figcaption>variant=Win</figcaption></figure>
<figure><div class="ds-gallery__stage"><section data-ds="contest-result" class="section contest-result contest-result--limit" aria-labelledby="cr-title-v2">
<div class="contest-result__inner">

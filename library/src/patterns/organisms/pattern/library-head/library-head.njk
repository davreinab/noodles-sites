{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>filtered (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><section data-ds="library-head" class="section library-head" aria-labelledby="lhead-title">
<div class="library-head__inner">
<div class="library-head__intro">
<h1 class="page-title" id="lhead-title">Recipes</h1>
<p class="library-head__lead">Explore and learn recipes to level up your dishes.</p>
</div>
<form class="search-field library-head__search" role="search" action="/recipes">
<span class="icon icon-search" aria-hidden="true"></span>
<label class="visually-hidden" for="lhead-q">Search a recipe or ingredient</label>
<input class="search-field__input" id="lhead-q" name="q" type="search" placeholder="Search a recipe or ingredient">
</form>
<ul class="library-head__filters" aria-label="Filter recipes">
<li><button class="chip" type="button" aria-pressed="true"><span class="icon icon-check" aria-hidden="true"></span>All</button></li>
<li><button class="chip" type="button" aria-pressed="false">Less ingredients</button></li>
<li><button class="chip" type="button" aria-pressed="false">Quick recipes</button></li>
<li><button class="chip" type="button" aria-pressed="false">High protein</button></li>
</ul>
<div class="library-head__results">
<p aria-live="polite"><strong>48</strong> results for your search</p>
<button class="link" type="button"><span class="icon icon-trash" aria-hidden="true"></span>Clear filters</button>
</div>
</div>
</section></div><figcaption>filtered=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><section data-ds="library-head" class="section library-head" aria-labelledby="lhead-title-v1">
<div class="library-head__inner">
<div class="library-head__intro">
<h1 class="page-title" id="lhead-title-v1">Recipes</h1>
<p class="library-head__lead">Explore and learn recipes to level up your dishes.</p>
</div>
<form class="search-field library-head__search" role="search" action="/recipes">
<span class="icon icon-search" aria-hidden="true"></span>
<label class="visually-hidden" for="lhead-q-v1">Search a recipe or ingredient</label>
<input class="search-field__input" id="lhead-q-v1" name="q" type="search" placeholder="Search a recipe or ingredient">
</form>
<ul class="library-head__filters" aria-label="Filter recipes">
<li><button class="chip" type="button" aria-pressed="true"><span class="icon icon-check" aria-hidden="true"></span>All</button></li>
<li><button class="chip" type="button" aria-pressed="false">Less ingredients</button></li>
<li><button class="chip" type="button" aria-pressed="false">Quick recipes</button></li>
<li><button class="chip" type="button" aria-pressed="false">High protein</button></li>
</ul>

</div>
</section></div><figcaption>filtered=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">La galería clona el elemento raíz del ejemplo y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<section data-ds="library-head" class="section library-head" aria-labelledby="lhead-title">
<div class="library-head__inner">
<div class="library-head__intro">
<h1 class="page-title" id="lhead-title">Recipes</h1>
<p class="library-head__lead">Explore and learn recipes to level up your dishes.</p>
</div>
<form class="search-field library-head__search" role="search" action="/recipes">
<span class="icon icon-search" aria-hidden="true"></span>
<label class="visually-hidden" for="lhead-q">Search a recipe or ingredient</label>
<input class="search-field__input" id="lhead-q" name="q" type="search" placeholder="Search a recipe or ingredient">
</form>
<ul class="library-head__filters" aria-label="Filter recipes">
<li><button class="chip" type="button" aria-pressed="true"><span class="icon icon-check" aria-hidden="true"></span>All</button></li>
<li><button class="chip" type="button" aria-pressed="false">Less ingredients</button></li>
<li><button class="chip" type="button" aria-pressed="false">Quick recipes</button></li>
<li><button class="chip" type="button" aria-pressed="false">High protein</button></li>
</ul>
<div class="library-head__results">
<p aria-live="polite"><strong>48</strong> results for your search</p>
<button class="link" type="button"><span class="icon icon-trash" aria-hidden="true"></span>Clear filters</button>
</div>
</div>
</section>{% endraw %}
{% endif %}
{% endmacro %}

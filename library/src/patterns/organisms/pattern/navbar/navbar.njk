{% macro render(data) %}
{% if data.view == "todas" %}
{% raw %}<div class="ds-gallery">
<style>.ds-gallery{font:14px/1.4 system-ui,sans-serif;color:#1f1f1f}.ds-gallery h3{font:600 12px/1.3 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px;color:#4a4a4a}.ds-gallery section{margin:0 0 32px}.ds-gallery__row{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px}.ds-gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;align-items:flex-start}.ds-gallery figcaption{font:12px/1.3 ui-monospace,monospace;color:#4a4a4a}.ds-gallery__stage{padding:8px;min-width:48px;min-height:32px;outline:1px dashed #bebebe;outline-offset:0}</style>
<section><h3>scrolled (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><header data-ds="navbar" class="navbar navbar--scrolled">
<div class="navbar__inner">
<div class="navbar__start"><button class="icon-button icon-button--secondary" type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu"><span class="icon icon-menu" aria-hidden="true"></span></button></div>
<a href="/" aria-label="Yatekomo, inicio"><img class="logo" src="/assets/ds/logos/logo-yatekomo-positive.svg" alt="Yatekomo"></a>
<div class="navbar__actions"><a class="button" href="/formula-natural">New 100% Natural Formula</a></div>
</div>
</header></div><figcaption>scrolled=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><header data-ds="navbar" class="navbar">
<div class="navbar__inner">
<div class="navbar__start"><button class="icon-button icon-button--secondary" type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu"><span class="icon icon-menu" aria-hidden="true"></span></button></div>
<a href="/" aria-label="Yatekomo, inicio"><img class="logo" src="/assets/ds/logos/logo-yatekomo-positive.svg" alt="Yatekomo"></a>
<div class="navbar__actions"><a class="button" href="/formula-natural">New 100% Natural Formula</a></div>
</div>
</header></div><figcaption>scrolled=false</figcaption></figure>
</div></section>
<section><h3>langSwitch (con y sin)</h3><div class="ds-gallery__row">
<figure><div class="ds-gallery__stage"><header data-ds="navbar" class="navbar">
<div class="navbar__inner">
<div class="navbar__start"><button class="icon-button icon-button--secondary" type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu"><span class="icon icon-menu" aria-hidden="true"></span></button></div>
<a href="/" aria-label="Yatekomo, inicio"><img class="logo" src="/assets/ds/logos/logo-yatekomo-positive.svg" alt="Yatekomo"></a>
<div class="navbar__actions"><a class="button" href="/formula-natural">New 100% Natural Formula</a><nav data-ds="lang-switch" class="lang-switch" aria-label="Idioma"><a class="lang-switch__option" href="/nl/" hreflang="nl" lang="nl" aria-current="true">NL</a><a class="lang-switch__option" href="/fr/" hreflang="fr" lang="fr">FR</a></nav></div>
</div>
</header></div><figcaption>langSwitch=true</figcaption></figure>
<figure><div class="ds-gallery__stage"><header data-ds="navbar" class="navbar">
<div class="navbar__inner">
<div class="navbar__start"><button class="icon-button icon-button--secondary" type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu"><span class="icon icon-menu" aria-hidden="true"></span></button></div>
<a href="/" aria-label="Yatekomo, inicio"><img class="logo" src="/assets/ds/logos/logo-yatekomo-positive.svg" alt="Yatekomo"></a>
<div class="navbar__actions"><a class="button" href="/formula-natural">New 100% Natural Formula</a></div>
</div>
</header></div><figcaption>langSwitch=false</figcaption></figure>
</div></section>
<p class="ds-gallery__note" style="font:13px/1.5 system-ui,sans-serif;color:#4a4a4a;max-width:75ch">No se han podido pintar: top=true (no hay clase ni atributo declarados para ella: declara su selector en modifiers). La galería clona el elemento raíz del ejemplo y solo cambia sus clases y atributos: una variante que necesita otro marcado (otro contenido, otro icono) puede verse incompleta; si es el caso, añádela al ejemplo de código.</p>
</div>{% endraw %}
{% else %}
{% raw %}<header data-ds="navbar" class="navbar">
<div class="navbar__inner">
<div class="navbar__start"><button class="icon-button icon-button--secondary" type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu"><span class="icon icon-menu" aria-hidden="true"></span></button></div>
<a href="/" aria-label="Yatekomo, inicio"><img class="logo" src="/assets/ds/logos/logo-yatekomo-positive.svg" alt="Yatekomo"></a>
<div class="navbar__actions"><a class="button" href="/formula-natural">New 100% Natural Formula</a></div>
</div>
</header>
<header data-ds="navbar" class="navbar">
<div class="navbar__inner">
<div class="navbar__start"><button class="icon-button icon-button--secondary" type="button" aria-label="Menú" aria-expanded="false" aria-controls="menu"><span class="icon icon-menu" aria-hidden="true"></span></button></div>
<a href="/" aria-label="Yatekomo, inicio"><img class="logo" src="/assets/ds/logos/logo-yatekomo-positive.svg" alt="Yatekomo"></a>
<div class="navbar__actions"><a class="button" href="/formula-natural">New 100% Natural Formula</a><nav data-ds="lang-switch" class="lang-switch" aria-label="Idioma"><a class="lang-switch__option" href="/nl/" hreflang="nl" lang="nl" aria-current="true">NL</a><a class="lang-switch__option" href="/fr/" hreflang="fr" lang="fr">FR</a></nav></div>
</div>
</header>{% endraw %}
{% endif %}
{% endmacro %}

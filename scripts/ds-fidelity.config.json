  "contrastExceptions": [],
  "coverageIgnore": {
    "values": [
      "hover",
      "focus",
      "focused",
      "pressed",
      "press",
      "active"
    ],
    "axes": [],
    "components": {
      "select": {
        "open=true": "Lista nativa del navegador: no se puede pintar en una muestra estática."
      },
      "textarea": {
        "filled=true": "El texto va dentro de la etiqueta, no en un atributo: se ve en el «Ejemplo de código»."
      },
      "button": {
        "iconLeading=true": "Los dos iconos llevan la misma clase .icon: un selector simple no distingue el inicial del final; se ve en el «Ejemplo de código».",
        "iconTrailing=true": "Los dos iconos llevan la misma clase .icon: un selector simple no distingue el inicial del final; se ve en el «Ejemplo de código»."
      }
    }
  },
  "_notes": {
    "modifiers": "Logo Version=Negative es otro archivo SVG (assets/logos/*-negative.svg) con la misma clase .logo: no hay modificador CSS. Contest card Status=Closed cambia el contenido (Badge Neutral y Link a ganadores), no el estilo. Video player Ratio=9:16 → .video-player--vertical.",
    "ignoreTokens": "font/style/* son nombres de estilo de Figma («Regular», «Bold»): en CSS los realiza font-family + font-weight, no una variable. color/effect/shadow-ink y shadow/soft van dentro de --elevation-* (box-shadow compuesto), que es lo que consume el CSS. Recipe card: el caption del maestro es el texto de marcador del hueco de imagen («Imagen de la receta»), que en código es la foto. layout/frame es el ancho del lienzo de diseño (1440/768/375), no una medida de CSS: las secciones ocupan el 100 % y el contenido se limita con --layout-content-max. Promo: color/text/secondary es el texto de marcador del hueco del arte de campaña («Arte de la campaña»), que en código es una imagen. Banner: space/16 es el padding del hueco de la imagen en el maestro; en código la pieza ocupa todo el marco.",
    "excludeAxes": "Además de los ejes por defecto: Checked, Selected y Expanded son estados y en código se expresan con ARIA (aria-checked, aria-pressed/aria-selected, aria-expanded), no con clases modificadoras."
  },
  "excludeAxes": [
